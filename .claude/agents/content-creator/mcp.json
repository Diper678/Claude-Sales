{
  "mcpServers": {
    "discord-creator": {
      "command": "node",
      "args": ["./shared/discord-channel/dist/discord.js"],
      "env": {
        "DISCORD_BOT_TOKEN": "${CREATOR_BOT_TOKEN}",
        "DISCORD_CHANNEL_ID": "${CREATOR_CHANNEL_ID}",
        "DISCORD_ALLOWED_USERS": "${DISCORD_OWNER_ID}",
        "AGENT_NAME": "creator"
      }
    }
  }
}
